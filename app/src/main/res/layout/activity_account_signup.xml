<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AccountSignup">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_editor_absoluteX="66dp"
        tools:layout_editor_absoluteY="28dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="259dp"
            android:layout_height="195dp"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo" />

        <TextView
            android:id="@+id/titlesignup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-black"
            android:textColor="#A8A6A6"
            android:textSize="34sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.493"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView" />

        <EditText
            android:id="@+id/correosignup"
            android:layout_width="210dp"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:ems="10"
            android:fontFamily="sans-serif-condensed-light"
            android:hint="Ingrese correo"
            android:inputType="text"
            android:textAlignment="center"
            android:textColorHint="#80D3D3D3"
            app:layout_constraintBottom_toTopOf="@+id/usersignup"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/usersignup"
            android:layout_width="210dp"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:ems="10"
            android:fontFamily="sans-serif-condensed-light"
            android:hint="Usuario"
            android:inputType="text"
            android:textAlignment="center"
            android:textColorHint="#80D3D3D3"
            app:layout_constraintBottom_toTopOf="@+id/passwordsignup"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="131dp"
            android:layout_marginEnd="132dp"
            android:layout_marginBottom="80dp"
            android:backgroundTint="#26960000"
            android:fontFamily="monospace"
            android:text="Crear cuenta"
            android:textColor="#CCD3D3D3"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeColor="#80397676" />

        <EditText
            android:id="@+id/passwordsignup2"
            android:layout_width="211dp"
            android:layout_height="57dp"
            android:layout_marginBottom="20dp"
            android:ems="10"
            android:fontFamily="sans-serif-condensed-light"
            android:hint="Repita contrasena"
            android:inputType="textPassword"
            android:textAlignment="center"
            android:textColorHint="#80D3D3D3"
            app:layout_constraintBottom_toTopOf="@+id/button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/passwordsignup"
            android:layout_width="211dp"
            android:layout_height="57dp"
            android:layout_marginStart="100dp"
            android:layout_marginEnd="100dp"
            android:layout_marginBottom="10dp"
            android:ems="10"
            android:fontFamily="sans-serif-condensed-light"
            android:hint="Contrasena"
            android:inputType="textPassword"
            android:textAlignment="center"
            android:textColorHint="#80D3D3D3"
            app:layout_constraintBottom_toTopOf="@+id/passwordsignup2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnbacksignup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#26960000"
            android:text="Volver"
            android:textColor="#CCD3D3D3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#80397676"
            app:strokeWidth="1sp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>