<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UsuarioForm">

    <Button
        android:id="@+id/btnbackusuarioform"
        style="@style/Boton.Volver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnbackusuarioform">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/titleusuarioform"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <TextView
                style="@style/Etiqueta"
                android:text="Nombre" />

            <EditText
                android:id="@+id/formUsuarioNombre"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="personName"
                android:inputType="textPersonName" />

            <TextView
                style="@style/Etiqueta"
                android:text="Apellido" />

            <EditText
                android:id="@+id/formUsuarioApellido"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="personName"
                android:inputType="textPersonName" />

            <TextView
                style="@style/Etiqueta"
                android:text="Correo electrónico" />

            <EditText
                android:id="@+id/formUsuarioEmail"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:hint="nombre@dominio.cl"
                android:inputType="textEmailAddress" />

            <TextView
                android:id="@+id/labelpassword"
                style="@style/Etiqueta"
                android:text="Contraseña" />

            <EditText
                android:id="@+id/formUsuarioPassword"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="password"
                android:inputType="textPassword" />

            <Switch
                android:id="@+id/formUsuarioActivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="Cuenta activa"
                android:textColor="@color/texto"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnsaveusuario"
                style="@style/Boton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Guardar" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
