<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnbackvecinoform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#26960000"
        android:fontFamily="sans-serif"
        android:text="Volver"
        android:textColor="#CCD3D3D3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#80397676"
        app:strokeWidth="1sp" />

    <TextView
        android:id="@+id/titlevecinoform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="Nuevo vecino"
        android:textColor="#A8A6A6"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnbackvecinoform" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlevecinoform">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/formVecinoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre completo"
                android:inputType="textPersonName"
                android:textColor="#CCD3D3D3"
                android:textColorHint="#80D3D3D3" />

            <EditText
                android:id="@+id/formVecinoRut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="RUT (12345678-5)"
                android:inputType="text"
                android:textColor="#CCD3D3D3"
                android:textColorHint="#80D3D3D3" />

            <EditText
                android:id="@+id/formVecinoDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Dirección"
                android:inputType="textPostalAddress"
                android:textColor="#CCD3D3D3"
                android:textColorHint="#80D3D3D3" />

            <EditText
                android:id="@+id/formVecinoTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Teléfono"
                android:inputType="phone"
                android:textColor="#CCD3D3D3"
                android:textColorHint="#80D3D3D3" />

            <EditText
                android:id="@+id/formVecinoGestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tipo de gestión"
                android:inputType="text"
                android:textColor="#CCD3D3D3"
                android:textColorHint="#80D3D3D3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Delegación (territorio)"
                android:textColor="#A8A6A6" />

            <Spinner
                android:id="@+id/formVecinoTerritorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Switch
                android:id="@+id/formVecinoActivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Activo"
                android:textColor="#CCD3D3D3" />

            <Button
                android:id="@+id/btnsavevecino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#26960000"
                android:text="Guardar"
                android:textColor="#CCD3D3D3"
                app:strokeColor="#80397676"
                app:strokeWidth="1sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
