<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Sensors">

    <Button
        android:id="@+id/btnbacksensors"
        style="@style/Boton.Volver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titlesensors"
        style="@style/Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Sensores"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnbacksensors" />

    <TextView
        android:id="@+id/txt_fecha"
        style="@style/Pista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlesensors" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_fecha">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Lectura principal: la temperatura manda. -->
            <LinearLayout
                android:id="@+id/cardTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/tarjeta"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imagen_temp"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="Temperatura"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/temperature" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Etiqueta"
                        android:text="Temperatura" />

                    <TextView
                        android:id="@+id/txt_temp"
                        style="@style/Titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:textAlignment="textStart"
                        android:textColor="@color/temperatura"
                        tools:text="25.77 °C" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardHum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/tarjeta"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imageView8"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Humedad"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/humidity" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Etiqueta"
                        android:text="Humedad" />

                    <TextView
                        android:id="@+id/txt_humedad"
                        style="@style/Subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:textColor="@color/humedad"
                        tools:text="68.97 %" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardLuz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/tarjeta"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imageView9"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Índice UV"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/uv" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Etiqueta"
                        android:text="Índice UV" />

                    <TextView
                        android:id="@+id/txtUVVal"
                        style="@style/Subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textAlignment="textStart"
                        android:textColor="@color/uv"
                        tools:text="UV 8" />

                </LinearLayout>

            </LinearLayout>

            <!-- Los dos controles, con su nombre debajo. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:id="@+id/imgNoti"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@color/tarjeta"
                        android:contentDescription="Linterna"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/flashlightoff" />

                    <TextView
                        style="@style/Pista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Linterna" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:id="@+id/imgAmpolleta"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@color/tarjeta"
                        android:contentDescription="Ampolleta"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/bulboff" />

                    <TextView
                        style="@style/Pista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ampolleta" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
