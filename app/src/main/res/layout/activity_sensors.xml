<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Sensors">

    <Button
        android:id="@+id/btnbacksensors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#26960000"
        android:text="Volver"
        android:textColor="#CCD3D3D3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#80397676"
        app:strokeWidth="1sp" />

    <!-- Temperatura -->
    <TextView
        android:id="@+id/titlesensors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="Sensores"
        android:textColor="#A8A6A6"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnbacksensors" />

    <!-- Humedad -->
    <LinearLayout
        android:id="@+id/cardTemp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="24dp"
        android:background="#12FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_fecha">

        <TextView
            android:id="@+id/txt_temp"
            android:layout_width="143dp"
            android:layout_height="42dp"
            android:fontFamily="sans-serif-smallcaps"
            android:singleLine="false"
            android:text="24.5°C"
            android:textAlignment="center"
            android:textColor="#FF5722"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imagen_temp"
            android:layout_width="110dp"
            android:layout_height="89dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/temperature" />

    </LinearLayout>

    <!-- Linterna y ampolleta, una al lado de la otra -->
    <ImageView
        android:id="@+id/imgNoti"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="32dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/imgAmpolleta"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardLuz"
        app:srcCompat="@drawable/flashlightoff" />

    <ImageView
        android:id="@+id/imgAmpolleta"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgNoti"
        app:layout_constraintTop_toBottomOf="@+id/cardLuz"
        app:srcCompat="@drawable/bulboff" />

    <LinearLayout
        android:id="@+id/cardLuz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:background="#12FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardHum">

        <TextView
            android:id="@+id/txtUVVal"
            android:layout_width="152dp"
            android:layout_height="47dp"
            android:fontFamily="sans-serif-smallcaps"
            android:text="UV 8"
            android:textAlignment="center"
            android:textColor="#FFC107"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="85dp"
            android:layout_height="103dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/uv" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardHum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:background="#12FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardTemp">

        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="212dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/humidity" />

        <TextView
            android:id="@+id/txt_humedad"
            android:layout_width="138dp"
            android:layout_height="57dp"
            android:fontFamily="sans-serif-smallcaps"
            android:text="62%"
            android:textAlignment="center"
            android:textColor="#2196F3"
            android:textSize="34sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Luz -->

    <TextView
        android:id="@+id/txt_fecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="TextView"
        android:textColor="#A8A6A6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlesensors" />

</androidx.constraintlayout.widget.ConstraintLayout>
