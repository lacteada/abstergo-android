<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConfirmationCode">

    <Button
        android:id="@+id/btnbackconfirmation"
        style="@style/Boton.Volver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="140dp"
        android:layout_height="105dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnbackconfirmation"
        app:srcCompat="@drawable/logo" />

    <TextView
        android:id="@+id/titleconfirmation"
        style="@style/Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Verificación"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView5" />

    <TextView
        android:id="@+id/subtitleconfirmation"
        style="@style/Pista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Revise su correo electrónico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleconfirmation" />

    <LinearLayout
        android:id="@+id/codeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleconfirmation">

        <EditText
            android:id="@+id/digit1"
            style="@style/Campo"
            android:layout_width="48dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/borde"
            android:fontFamily="monospace"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textAlignment="center"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/digit2"
            style="@style/Campo"
            android:layout_width="48dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/borde"
            android:fontFamily="monospace"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textAlignment="center"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/digit3"
            style="@style/Campo"
            android:layout_width="48dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/borde"
            android:fontFamily="monospace"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textAlignment="center"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/digit4"
            style="@style/Campo"
            android:layout_width="48dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/borde"
            android:fontFamily="monospace"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textAlignment="center"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/digit5"
            style="@style/Campo"
            android:layout_width="48dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/borde"
            android:fontFamily="monospace"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textAlignment="center"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/digit6"
            style="@style/Campo"
            android:layout_width="48dp"
            android:backgroundTint="@color/borde"
            android:fontFamily="monospace"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textAlignment="center"
            android:textSize="22sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/filaContador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/codeContainer">

        <TextView
            android:id="@+id/txtContador"
            style="@style/Pista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="monospace"
            android:text="El código vence en 60s" />

        <Button
            android:id="@+id/btnReenviar"
            style="@style/Boton.Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Reenviar" />
    </LinearLayout>

    <Button
        android:id="@+id/btnverifycode"
        style="@style/Boton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:text="Verificar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/filaContador" />

</androidx.constraintlayout.widget.ConstraintLayout>
